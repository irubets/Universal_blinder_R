{
  "_comment": "Universal Blinder generic configuration (schema 2). Describes the ROLE of standard SDTM/ADaM variables. It contains no study-specific values: treatment/analyte names, IDs and aliases are discovered from the data or supplied in a private study file (study.json) that never belongs in this repository. Variables listed here that are absent from a dataset are ignored.",
  "schema_version": 2,
  "placeholder_naming": {
    "studyid_blind": "STUDY-XXX",
    "usubjid_blind_template": "{studyid_blind}-{subjid_blind}",
    "subjid_blind_template": "S{seq:04d}",
    "siteid_blind_template": "SITE{seq:03d}",
    "treat_blind_template": "TREAT_{seq:02d}",
    "treat_alias_blind_template": "Tab{seq:02d}",
    "analyte_name_blind_template": "ANALYTE_{seq:02d}",
    "analyte_code_blind_template": "ANALYT{seq:02d}",
    "analyte_alias_blind_template": "Anb{seq:02d}",
    "analyte_code_alias_blind_template": "ANL{seq:02d}X",
    "private_term_blind_template": "TERM_{seq:02d}",
    "_comment": "Tokens must have at least two cased letters with mixed forms so that UPPER/lower/Title renderings are distinct; this is what makes case-preserving replacement reversible. A running letter suffix (a, b, ...) is appended to alias tokens when an identity has more than one alias."
  },
  "codebook": {
    "_comment": "Codes used when the study has a codebook (the study-folder runner: private/codebook.csv). Treatments become TRT01, TRT02, ...; analytes ANL01, ... (a drug that is also an analyte gets the same number); other private text TERM01, ...; a code is written exactly as given, whatever the case of the text it replaces. category_groups: descriptive grouping variables whose WHOLE value is replaced by one code per value ({group}{seq}: ARM01, ARMCD01, ...). number_with: a group whose values are 1:1 with the named group's values takes the same numbers (ARMCD01 is the arm code of ARM01). in_text: the group's values (of at least category_in_text_min_length characters) are also replaced where they occur inside released free text, e.g. the arm inside APROFILE. A study can change the groups under config_overrides.",
    "treatment_template": "TRT{seq:02d}",
    "analyte_template": "ANL{seq:02d}",
    "text_template": "TERM{seq:02d}",
    "category_template": "{group}{seq:02d}",
    "category_in_text_min_length": 6,
    "category_groups": {
      "ARM": {
        "vars": [
          "ARM",
          "ACTARM"
        ],
        "in_text": true
      },
      "ARMCD": {
        "vars": [
          "ARMCD",
          "ACTARMCD"
        ],
        "number_with": "ARM"
      },
      "COHORT": {
        "vars": [
          "COHORT"
        ],
        "number_with": "ARM",
        "in_text": true
      },
      "COHORTCD": {
        "vars": [
          "COHORTCD"
        ],
        "number_with": "ARM"
      },
      "REGIMEN": {
        "vars": [
          "TRT01P",
          "TRT01A",
          "TRT02P",
          "TRT02A",
          "TRT03P",
          "TRT03A",
          "TRTSEQP",
          "TRTSEQA"
        ],
        "number_with": "ARM",
        "in_text": true
      }
    }
  },
  "numeric_blinding": {
    "multiplier_low": 0.8,
    "multiplier_high": 1.2,
    "subject_extra_decimals": 1,
    "lloq_extra_decimals": 1,
    "max_inferred_decimals": 6,
    "bql_imputed_action": "blank",
    "_comment": "Blinded values are rounded to the source precision (+extra decimals for per-subject covariates and LLOQ). Never publish full-precision products: they let the factor be factored back out (see docs/design.md). bql_imputed_action: 'blank' (default) releases a non-zero result on a BQL record (e.g. LLOQ/2) as missing, together with the values derived from it (analyte_numeric.bql_dependent_vars); next to the blinded LLOQ it would reveal the subject's factor. 'flag' keeps and scales it and makes QC fail (check bql_imputed_value)."
  },
  "date_blinding": {
    "enabled": true,
    "mode": "per_subject",
    "shift_days_min": 30,
    "shift_days_max": 365,
    "study_constant_date_vars": [
      "CUTOFFDT",
      "CUTOFFDTC",
      "DCUTDT",
      "DCUTDTC",
      "DATACUTDT"
    ],
    "detect_by_format": true,
    "detect_by_name_suffix": true,
    "exclude_vars": [],
    "shared_date_warn_fraction": 0.25,
    "shared_date_min_subjects": 5,
    "partial_dtc_action": "blank",
    "_comment": "mode per_subject: every date of one subject moves by the same random number of days, so *DY and durations stay exact. Study-constant dates (data cut-off) get one study-level shift instead, because shifting a shared calendar date per subject would reveal each subject's offset. mode per_study: a single offset for everybody. partial_dtc_action: 'blank' (default) removes year-only / year-month ISO dates, which cannot be shifted and would otherwise publish real calendar information; 'keep' leaves them and reports a QC warning."
  },
  "qc": {
    "quasi_identifier_dataset": "ADSL",
    "quasi_identifiers": [
      "COUNTRY",
      "RACE",
      "ETHNIC",
      "SEX"
    ],
    "k_threshold": 5,
    "free_text_date_check": true,
    "gcd_attack_min_records": 5
  },
  "common_suppress_vars": [
    "BRTHDTC",
    "BRTHDT",
    "BRTHDTM",
    "INVNAM",
    "INVID",
    "*REFID",
    "*LNKID",
    "*LNKGRP",
    "*NAM",
    "DDAENO",
    "DSAENO",
    "*REASP",
    "*OTH",
    "*SPID"
  ],
  "_comment_suppress": "Suppressed variables are blanked (character) or set to missing (numeric) and are NOT restored by unblinding. '*' is a wildcard. Birth dates are suppressed because birth year + any real date re-derives the true AGE. *REFID/*LNKID/*LNKGRP hold lab accession numbers, encoded datetimes and codes built from drug abbreviations; *NAM holds vendor/investigator names; *REASP, *OTH (other-specify) and AE-number texts are free text that can contain real dates or names.",
